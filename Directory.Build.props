<Project>
  <!-- Metadata for this repository's projects only; third-party components retain their own licenses. -->
  <PropertyGroup>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lilixiu708-ai/DictationAssistant_IntegratedTyping</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'DictationAssistant.App'">
    <Description>支持 Word/Excel 词表导入、语音播报、随机顺序、同步打字练习、成绩导出与插件扩展的桌面听写工具。</Description>
    <IsPackable>false</IsPackable>
    <Copyright>Copyright (C) 2013-2026 alampy.com. Original notices retained; see NOTICE.md for this distribution.</Copyright>
  </PropertyGroup>
</Project>
