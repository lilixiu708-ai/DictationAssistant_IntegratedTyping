<!-- Modified 2026-10-19: shared document plugin API and reproducible Windows build. -->
<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../DictationAssistant.Plugin.Abstractions/DictationAssistant.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ALampy.XamlFontPicker.Avalonia" Version="2.0.1" />
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="EdgeTTS.DotNet" Version="0.4.0" />
    <PackageReference Include="HexaGen.Runtime" Version="1.1.24" />
    <PackageReference Include="ManagedBass" Version="3.0.0" />
    <PackageReference Include="MessageBox.Avalonia" Version="3.3.1.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NCalcSync" Version="5.12.0" />
    <PackageReference Include="Hexa.NET.SDL2" Version="1.2.17" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\WordlistHighlighting.xshd" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\deploy\shared\EULA.txt" Link="Resources\EULA.txt" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>4.0.0-typing.2</Version>
    <ApplicationIcon>Assets\DictationAssistant.ico</ApplicationIcon>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\DictationAssistant.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == ''">
    <Content Include="BassRuntimeAssets/**/*">
      <Visible>False</Visible>
      <PublishState>Included</PublishState>
      <TargetPath>runtimes/%(RecursiveDir)/%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <Content Include="BassRuntimeAssets/$(RuntimeIdentifier)/native/*">
      <Visible>False</Visible>
      <PublishState>Included</PublishState>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
